# @BotFather bergan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin Telegram ID lari (vergul bilan). O'z ID ingizni @userinfobot dan oling.
ADMIN_IDS=123456789

# --- Ma'lumotlar bazasi ---
# sqlite — bitta fayl (lokal ish uchun qulay)
# mysql  — server uchun; quyidagi MYSQL_* sozlamalari ishlatiladi
DB_TYPE=sqlite

# DB_TYPE=sqlite bo'lganda:
DB_PATH=qabul.db

# DB_TYPE=mysql bo'lganda (aaPanel'da baza yarating va shu yerga yozing).
# Parol faqat shu faylda turadi — .env `.gitignore` da, hech kimga bermang.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=qabul_bot
MYSQL_PASSWORD=
MYSQL_DATABASE=qabul_bot

# Ixtiyoriy: TLS sertifikatlari to'plami.
# Tashkilot tarmog'i TLS trafikni tekshirsa (CERTIFICATE_VERIFY_FAILED xatosi),
# shu yerga .pem faylni ko'rsating. Bo'sh qoldirilsa SSL_CERT_FILE muhit
# o'zgaruvchisi, u ham bo'lmasa certifi ishlatiladi.
CA_BUNDLE=

# Yozishmadagi fayllar nusxasi saqlanadigan papka.
FILES_DIR=files

# Adminlar ishlaydigan guruh. Botni guruhga qo'shib /id yozing — u shu raqamni beradi.
# Bo'sh qoldirilsa xabarlar faqat ADMIN_IDS dagi shaxsiy chatlarga boradi.
GROUP_ID=

# --- Matrix (Element) ---
# Xodimlar Telegram bloklangan kompyuterlarda ishlasa, arizalar Matrix xonasiga
# ham tushadi va javob o'sha yerdan beriladi. Bo'sh qoldirilsa Matrix ishlamaydi.
MATRIX_HOMESERVER=https://matrix.example.uz
MATRIX_USER=@qabulbot:example.uz
MATRIX_PASSWORD=
# Parol o'rniga tayyor token ishlatsa ham bo'ladi:
MATRIX_TOKEN=
# Botni xonaga qo'shib, xonada !id yozing yoki Element sozlamalaridan oling.
MATRIX_ROOM_ID=
# Kim javob bera oladi. Bo'sh bo'lsa — xonaning barcha a'zolari.
MATRIX_ADMINS=
